# Copy to .env.local and fill in from Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The "publishable" key (sb_publishable_...) or the legacy "anon" key both work
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only, never NEXT_PUBLIC: lets the server save verified leaderboard
# scores (Project Settings > API > service_role). Keep it secret.
SUPABASE_SERVICE_ROLE_KEY=
# Any random string; used to hash IPs for leaderboard rate limiting
SCORE_SALT=
# Your live domain once deployed (used in email links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Heads-up emails to you (new booking requests, new sign-ups), sent through
# Gmail. GMAIL_APP_PASSWORD is a Google "app password", not your real one.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Where the heads-up emails go (defaults to the site email in src/lib/site.ts)
NOTIFY_EMAIL=
